local function SafeGet(key, fallback)
    local ok, v = pcall(function()
        return modules.PlayerDataController and modules.PlayerDataController:Get(key)
    end)
    return (ok and v ~= nil) and v or fallback
end

local state = {
    fake_owned        = SafeGet("CosmeticInventory", {}),
    fake_weapon_owned = SafeGet("WeaponInventory", {}),
    equipped          = {},
    favorites         = {},
    fake_weapon_names = {},
    constructing_weapon = nil,
    last_used_weapon  = nil,
    placed_object_map = {},
    viewing_profile   = nil,
}

local UNLOCK_FILE = "xcy_skinchanger_unlock.json"
local EQUIP_FILE  = "xcy_skinchanger_equipped.json"

local function SaveUnlockState(val)
    pcall(function()
        if writefile then
            writefile(UNLOCK_FILE, HttpService:JSONEncode({ enabled = val }))
        end
    end)
end

local function LoadUnlockState()
    local ok, data = pcall(function()
        if isfile and isfile(UNLOCK_FILE) and readfile then
            return HttpService:JSONDecode(readfile(UNLOCK_FILE))
        end
    end)
    if ok and type(data) == "table" then return data.enabled == true end
    return true
end

local function SaveEquipped()
    pcall(function()
        if writefile then
            writefile(EQUIP_FILE, HttpService:JSONEncode(state.equipped))
        end
    end)
end

local function LoadEquipped()
    local ok, data = pcall(function()
        if isfile and isfile(EQUIP_FILE) and readfile then
            return HttpService:JSONDecode(readfile(EQUIP_FILE))
        end
    end)
    if ok and type(data) == "table" then
        state.equipped = data
    end
end

pcall(LoadEquipped)

pcall(function()
    if not modules.PlayerDataController then return end
    local original = modules.PlayerDataController.Get
    modules.PlayerDataController.Get = function(self, key, ...)
        local data = original(self, key, ...)
        if key == "CosmeticInventory" then return state.fake_owned or data end
        if key == "WeaponInventory" or key == "FreeWeaponUnlockCheck" then return state.fake_weapon_owned or data end
        return data
    end
end)

pcall(function()
    if not modules.CosmeticLibrary then return end
    local cos = modules.CosmeticLibrary
    local function WrapOwnership(old, idx)
        return function(...)
            local args = {...}
            local name = args[idx]
            if type(name) == "string" and state.fake_owned[name] then return true end
            if old then return old(...) end
            return false
        end
    end
    if cos.OwnsCosmeticNormally      then cos.OwnsCosmeticNormally      = WrapOwnership(cos.OwnsCosmeticNormally, 3) end
    if cos.OwnsCosmeticUniversally   then cos.OwnsCosmeticUniversally   = WrapOwnership(cos.OwnsCosmeticUniversally, 3) end
    if cos.OwnsCosmeticForSomething  then cos.OwnsCosmeticForSomething  = WrapOwnership(cos.OwnsCosmeticForSomething, 3) end
    if cos.OwnsCosmeticForWeapon     then cos.OwnsCosmeticForWeapon     = WrapOwnership(cos.OwnsCosmeticForWeapon, 3) end
    if cos.OwnsCosmetic then
        local orig = cos.OwnsCosmetic
        cos.OwnsCosmetic = function(self, inventory, name, weapon)
            if type(name) == "string" and state.fake_owned[name] then return true end
            if orig then return orig(self, inventory, name, weapon) end
            return false
        end
    end
end)

pcall(function()
    if not modules.PlayerDataController then return end
    local pdc = modules.PlayerDataController
    if pdc.GetWeaponData then
        local orig = pdc.GetWeaponData
        pdc.GetWeaponData = function(p1, ...)
            local weapon_name = ({...})[1]
            local original_data, index = orig(p1, ...)
            local fake_owned = false
            for _, weapon in ipairs(state.fake_weapon_owned) do
                if type(weapon) == "table" and weapon.Name == weapon_name then fake_owned = true; break end
            end
            if fake_owned and not original_data then
                local fake_data = { Name = weapon_name, Level = 1, XP = 0, IsFavorited = false, Skin = nil }
                local equipped = state.equipped
                if equipped and equipped[weapon_name] then
                    for cos_type, cos_data in pairs(equipped[weapon_name]) do
                        if type(cos_data) == "table" and (cos_data.Name == "NONE_COSMETIC" or cos_data.Name == "None") then
                            fake_data[cos_type] = nil
                        else
                            fake_data[cos_type] = cos_data
                        end
                    end
                end
                return fake_data, index
            end
            local equipped = state.equipped
            if original_data and equipped and equipped[weapon_name] then
                for cos_type, cos_data in pairs(equipped[weapon_name]) do
                    if type(cos_data) == "table" and (cos_data.Name == "NONE_COSMETIC" or cos_data.Name == "None") then
                        original_data[cos_type] = nil
                    else
                        original_data[cos_type] = cos_data
                    end
                end
            end
            return original_data, index
        end
    end
end)

task.spawn(function()
    while not (modules.PlayerDataController and modules.PlayerDataController.CurrentData) do
        task.wait(0.1)
    end
    local cd = modules.PlayerDataController.CurrentData
    if type(cd.Get) ~= "function" or cd._fakeOwnedPatched then return end
    local old_get = cd.Get
    cd.Get = function(self, ...)
        local data = old_get(self, ...)
        local key = ({...})[1]
        if key == "CosmeticInventory" then return state.fake_owned or data end
        if key == "WeaponInventory" or key == "FreeWeaponUnlockCheck" then return state.fake_weapon_owned or data end
